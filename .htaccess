# ==============================================================================
# BỘ KHIÊN BẢO VỆ XAMPP PUBLIC (Bằng .htaccess)
# ==============================================================================

# 1. Tắt tính năng hiển thị danh sách thư mục (Ngăn hacker xem danh sách file trong /assets/, /uploads/...)
Options -Indexes

# 2. Chặn đứng việc truy cập vào file .env và tất cả các thư mục/file ẩn (như .git, .vscode)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 3. Chặn tuyệt đối việc tải xuống các file dữ liệu nhạy cảm (Đặc biệt là file .sql)
<FilesMatch "\.(sql|log|ini|json|bak|swp)$">
    Require all denied
</FilesMatch>

# 4. Tăng cường Header bảo mật (Chống nhúng web vào iframe giả mạo, chống XSS)
<IfModule mod_headers.c>
    Header always append X-Frame-Options SAMEORIGIN
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options nosniff
</IfModule>
